dataset/*.parquet
dataset/*.gz

# ── Scoring outputs ───────────────────────────────────────────────────────────
pipeline/scoring/output/
pipeline/scoring/*.parquet

# ── MLflow ────────────────────────────────────────────────────────────────────
mlruns/
mlartifacts/
mlflow.db

# ── dbt ───────────────────────────────────────────────────────────────────────
dbt/target/
dbt/dbt_packages/
dbt/*.duckdb
dbt/logs/

# ── Airflow ───────────────────────────────────────────────────────────────────
airflow/logs/
airflow/plugins/
airflow.cfg
airflow.db
webserver_config.py

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
secrets/

# ── OS & editors ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel/

